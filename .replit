modules = ["nodejs-20"]
run = "npm start"

[[ports]]
localPort = 3000
externalPort = 80

[deployment]
deploymentTarget = "cloudrun"
run = ["npm", "start"]

[nix]
channel = "stable-25_05"

# Versión de prueba: que ningún buscador la indexe.
[[deployment.responseHeaders]]
path = "/*"
name = "X-Robots-Tag"
value = "noindex, nofollow"
