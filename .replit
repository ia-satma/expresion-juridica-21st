# Sitio estático de Expresión Jurídica (versión de prueba, noindex). Se construye en
# ~/JHH/sitio-21st (npm run build) y aquí solo vive el resultado, en sitio/.
modules = ["nodejs-22"]
run = "npx --yes serve@14.2.4 sitio -l 3000"

[[ports]]
localPort = 3000
externalPort = 80

[deployment]
deploymentTarget = "static"
publicDir = "sitio"
