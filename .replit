modules = ["web"]
run = "npx --yes serve@14.2.4 sitio -l 3000"

[[ports]]
localPort = 3000
externalPort = 80

[deployment]
deploymentTarget = "static"
publicDir = "sitio"

[nix]
channel = "stable-25_05"

# Tipos que el hospedaje estático no reconoce: el iPhone necesita saber que es video en partes (HLS).
[[deployment.responseHeaders]]
path = "/video/hls/expresion-juridica/index.m3u8"
name = "Content-Type"
value = "application/vnd.apple.mpegurl"

[[deployment.responseHeaders]]
path = "/video/hls/expresion-juridica-vertical/index.m3u8"
name = "Content-Type"
value = "application/vnd.apple.mpegurl"

[[deployment.responseHeaders]]
path = "/video/hls/expresion-juridica/parte-*"
name = "Content-Type"
value = "video/mp2t"

[[deployment.responseHeaders]]
path = "/video/hls/expresion-juridica-vertical/parte-*"
name = "Content-Type"
value = "video/mp2t"

# Versión de prueba: que ningún buscador la indexe.
[[deployment.responseHeaders]]
path = "/*"
name = "X-Robots-Tag"
value = "noindex, nofollow"
