modules = ["nodejs-20"]
run = "npm start"

[[ports]]
localPort = 3000
externalPort = 80

[deployment]
deploymentTarget = "cloudrun"
run = ["npm", "start"]

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
REPLIT_OBJECT_STORAGE_BUCKET_ID = "replit-objstore-4f9d488b-7850-4525-b68a-bd572fbb1d10"

# Versión de prueba: que ningún buscador la indexe.
[[deployment.responseHeaders]]
path = "/*"
name = "X-Robots-Tag"
value = "noindex, nofollow"
