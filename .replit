modules = ["web"]
run = "npx --yes serve@14.2.4 sitio -l 3000"

[[ports]]
localPort = 3000
externalPort = 80

[deployment]
deploymentTarget = "static"
publicDir = "sitio"

[nix]
channel = "stable-25_05"

# Versión de prueba: que ningún buscador la indexe.
[[deployment.responseHeaders]]
path = "/*"
name = "X-Robots-Tag"
value = "noindex, nofollow"
