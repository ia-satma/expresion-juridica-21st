# Better Auth: use a high-entropy value of at least 32 characters in Replit Secrets.
BETTER_AUTH_SECRET=replace-with-a-32-character-secret
BETTER_AUTH_URL=http://localhost:3000
CMS_OWNER_EMAIL=ia@satma.mx
CMS_GOOGLE_ALLOWED_DOMAIN=satma.mx
CMS_GOOGLE_DEFAULT_ROLE=viewer
# Google OAuth credentials from Google Cloud Console. Leave blank to hide the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Replit deployment: https://expresion-juridica-21-st.replit.app

# Replit can expose these automatically; set them explicitly only when needed.
# REPLIT_DEV_DOMAIN=your-repl.replit.dev
# REPLIT_DEPLOYMENT_URL=https://your-deployment.replit.app
