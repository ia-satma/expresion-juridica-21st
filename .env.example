# Better Auth: use a high-entropy value of at least 32 characters in Replit Secrets.
BETTER_AUTH_SECRET=replace-with-a-32-character-secret
BETTER_AUTH_URL=http://localhost:3000
# Dominios que pueden abrir el CMS. Separa los hosts con comas al conectar otro dominio.
CMS_AUTH_ALLOWED_HOSTS=expresionjuridica.com,www.expresionjuridica.com,expresion-juridica-mx.replit.app,expresion-juridica-21-st.replit.app
CMS_OWNER_EMAIL=ia@satma.mx
# PostgreSQL en producción: usa DATABASE_URL de Replit o configura CMS_AUTH_DATABASE_URL.
# CMS_AUTH_STORAGE=postgres
# CMS_AUTH_DATABASE_URL=postgresql://...
# Introduce este valor solo como secreto temporal de producción y elimínalo tras verificar el acceso.
# CMS_OWNER_BOOTSTRAP_PASSWORD=
# Optional in a transferred Replit project; defaults to the deployment URL.
CMS_CANONICAL_BASE_URL=
# Mantén los datos separados: development en tu workspace y production en Deployment.
CMS_DATA_SCOPE=development
# Agentes de texto: Fast conserva el modelo y razonamiento; su tarifa es distinta.
# Usa default para volver explícitamente al procesamiento estándar.
OPENAI_TEXT_SERVICE_TIER=fast
# Minimum gap between image-generation requests. Increase this for low image RPM tiers.
OPENAI_IMAGE_MIN_REQUEST_INTERVAL_MS=12000
# OpenAI key for server-side text, images and document agents.
# OPENAI_API_KEY=replace-with-a-replit-secret
# Replit deployment: https://expresion-juridica-21-st.replit.app
# Optional: the ID of the named App Storage bucket created in Replit.
# REPLIT_OBJECT_STORAGE_BUCKET_ID=your-bucket-id
# If Replit provides the default bucket automatically, the server also accepts:
# DEFAULT_OBJECT_STORAGE_BUCKET_ID=your-default-bucket-id

# Replit can expose these automatically; set them explicitly only when needed.
# REPLIT_DEV_DOMAIN=your-repl.replit.dev
# REPLIT_DEPLOYMENT_URL=https://your-deployment.replit.app
# Seguridad de acceso al CMS (configuración predeterminada)
# Sesión: máximo absoluto de 8 horas, caducidad tras 30 minutos sin actividad humana y aviso 2 minutos antes.
# Después de 5 errores para una cuenta en 15 minutos, se bloquea 15 minutos.
# El límite de 25 fallos/IP requiere una identidad de cliente verificada por el servidor.
# Sin proxy verificado: presupuesto compartido de 100 fallos/60 s y hasta 10 comprobaciones simultáneas; espera breve de 10 s, sin bloqueo global de 15 minutos.
